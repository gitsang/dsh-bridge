{
  "name": "@gitsang/dsh-bridge",
  "version": "2.0.0",
  "description": "Put multiple complete DeepSeek Harness hosts behind one authenticated path-prefix gateway.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./gateway": "./src/gateway.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bridge",
    "gateway",
    "reverse-proxy",
    "pi",
    "codex",
    "opencode"
  ],
  "dsh": {
