{
  "name": "@gitsang/dsh-bridge",
  "version": "0.4.0",
  "description": "Bridge multiple external coding agents (Pi, Codex, OpenCode, remote DSH) into the DeepSeek Harness web UI.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:secrets": "./tests/check-secrets.sh",
    "test:live": "node tests/live-smoke.mjs",
    "test:live:attach": "DSH_SMOKE_ATTACH=1 node tests/live-smoke.mjs",
    "setup:live": "node tests/live-setup.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bridge",
    "agent",
    "pi",
    "codex",
    "opencode",
    "web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsang/dsh-bridge.git"
  }
}
